{
  "name": "cloudfs",
  "version": "0.1.0",
  "description": "Local desktop file explorer for this computer, Amazon S3, and FTP.",
  "author": "Cloudfs",
  "engines": {
    "node": ">=24.22.1"
  },
  "private": true,
  "main": "dist/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcworldwide/cloudfs.git"
  },
  "scripts": {
    "start": "npm run build:electron && concurrently -k -n vite,app \"vite\" \"wait-on tcp:127.0.0.1:5173 file:dist/electron/main.js && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false",
    "dist": "npm run build && electron-builder --dir",
    "dist:ci": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "basic-ftp": "^6.2.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
